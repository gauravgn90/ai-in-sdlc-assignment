+namespace InvoiceApp.Domain;
+
+/// <summary>Totals of approved invoices for the month-end finance close.</summary>
+public class MonthEndReport
+{
+    private readonly IInvoiceRepository _invoices;
+
+    public MonthEndReport(IInvoiceRepository invoices)
+    {
+        _invoices = invoices;
+    }
+
+    public decimal ApprovedTotal(DateTime period)
+    {
+        return _invoices.GetAll()
+            .Where(invoice => invoice.Status == InvoiceStatus.Approved
+                && invoice.DecidedAt.HasValue
+                && invoice.DecidedAt.Value.Month == period.Month)
+            .Sum(invoice => invoice.Amount);
+    }
+}
